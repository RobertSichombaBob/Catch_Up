{
  "name": "catchup-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "TypeScript islands for Catch Up. Builds to ../static/js/app.js (committed, so Render needs no Node).",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/main.ts --bundle --minify --sourcemap --target=es2019 --outfile=../static/js/app.js",
    "watch": "esbuild src/main.ts --bundle --sourcemap --target=es2019 --outfile=../static/js/app.js --watch",
    "typecheck": "tsc --noEmit",
    "katex": "node scripts/copy-katex.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "katex": "0.16.22",
    "typescript": "5.9.3"
  }
}
