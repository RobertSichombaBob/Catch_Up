# Copy this file to .env for local development (Windows: copy .env.example .env).
# Never commit .env. On Render, set these in the dashboard instead.
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
# Leave DATABASE_URL empty to use db.sqlite3 locally, or point at Postgres:
# DATABASE_URL=postgres://user:password@localhost:5432/catchup
SITE_URL=http://localhost:8000

# Payments: "simulator" moves no money. Use "pawapay" with a token for real payments.
PAYMENT_PROVIDER=simulator
ALLOW_PAYMENT_SIMULATOR=true
PAWAPAY_SANDBOX=true
PAWAPAY_API_TOKEN=
PAYMENT_FEE_PERCENT=0
TUTOR_SHARE_PERCENT=50
COURSE_PRICE_ZMW=80.00

# Email. Empty EMAIL_HOST prints emails to the console.
# Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, your Gmail address and an App Password.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Catch Up <no-reply@example.com>
SUPPORT_EMAIL=support@example.com

# Accounts created by "seed_catchup" and "ensure_superuser"
SEED_ACCOUNT_PASSWORD=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Uploads: local folder by default. For S3 or Cloudflare R2 set the bucket values.
# MEDIA_ROOT=/var/data/media
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=
